<?xml version="1.0" encoding="UTF-8" ?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description
  >Org Intelligence : accès à Jira Cloud (e-mail + jeton d&apos;API, saisis dans Settings et chiffrés par Salesforce).</description>
    <externalCredentialParameters>
        <parameterName>Authorization</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue
    >{!&apos;Basic &apos; &amp; BASE64ENCODE(BLOB($Credential.OrgIntelligenceJira.Email &amp; &apos;:&apos; &amp; $Credential.OrgIntelligenceJira.ApiToken))}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>JiraUser</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Org Intelligence Jira</label>
</ExternalCredential>
