<?xml version="1.0" encoding="UTF-8" ?>
<!-- Org Intelligence - module Adoption (licences et fonctionnalités utilisées), profil administrateur.
     À assigner en plus du permission set Org Intelligence - Admin du socle. Aucun objet : l'analyse et
     le contrat sont gardés dans le navigateur. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <customPermissions>
        <enabled>true</enabled>
        <name>OrgIntelligence_Adoption</name>
    </customPermissions>
    <description
  >Org Intelligence Adoption module - admin access. Assign together with "Org Intelligence - Admin".</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Org Intelligence - Adoption Admin</label>
</PermissionSet>
