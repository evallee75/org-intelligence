<?xml version="1.0" encoding="UTF-8" ?>
<!-- Org Intelligence - module Security (audit de sécurité et rapport imprimable), profil administrateur.
     À assigner en plus du permission set Org Intelligence - Admin du socle. Sans objet : l'accès est
     donné par la custom permission OrgIntelligence_Security. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <customPermissions>
        <enabled>true</enabled>
        <name>OrgIntelligence_Security</name>
    </customPermissions>
    <description
  >Org Intelligence Security module - admin access (security audit and printable report). Assign together with "Org Intelligence - Admin".</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Org Intelligence - Security Admin</label>
</PermissionSet>
