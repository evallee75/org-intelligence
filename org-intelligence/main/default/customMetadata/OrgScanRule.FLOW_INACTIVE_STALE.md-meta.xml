<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Flows - Stale inactive flow</label>
    <protected>true</protected>
    <values>
        <field>Domain__c</field>
        <value xsi:type="xsd:string">Flow</value>
    </values>
    <values>
        <field>IsEnabled__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Severity__c</field>
        <value xsi:type="xsd:string">Low</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">Maintainability</value>
    </values>
    <values>
        <field>Confidence__c</field>
        <value xsi:type="xsd:string">Medium</value>
    </values>
    <values>
        <field>Threshold__c</field>
        <value xsi:type="xsd:double">180</value>
    </values>
    <values>
        <field>Description__c</field>
        <value
      xsi:type="xsd:string"
    >The flow has no active version and has not been modified for more days than the threshold.</value>
    </values>
    <values>
        <field>Rationale__c</field>
        <value
      xsi:type="xsd:string"
    >Old inactive flows clutter the org and confuse administrators. Inactivity is a fact; whether the flow is still useful must be confirmed by its owner.</value>
    </values>
    <values>
        <field>SuggestedAction__c</field>
        <value
      xsi:type="xsd:string"
    >Check with the owner whether the flow is still needed, then delete it or document why it is kept.</value>
    </values>
</CustomMetadata>
